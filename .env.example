# Optional protection for this proxy's /v1 endpoints.
CLAUDE_PROXY_API_KEY=replace-with-a-random-local-secret

CLAUDE_PROXY_HOST=127.0.0.1
CLAUDE_PROXY_PORT=8901
CLAUDE_PROXY_MODEL=claude-haiku-4-5-20251001
CLAUDE_PROXY_TIMEOUT_MS=300000
CLAUDE_PROXY_MAX_CONCURRENT=4

# Use either Claude Code login or an Anthropic API key. Never commit the value.
# ANTHROPIC_API_KEY=
